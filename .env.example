# =============================================================================
# Orders & KDS Backend — Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in the values for your local environment:
#   cp .env.example .env
#
# NEVER commit .env to version control.  Only .env.example (this file, without
# real values) is versioned.  A secret scanner (gitleaks) runs on every push.
#
# Variables are in UPPER_SNAKE_CASE as required by DEVELOPMENT_GUIDELINES §2.1.
# For the full description of each variable see docs/CONTRIBUTING.md §7.1.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Async connection string for PostgreSQL 16.
# Driver: asyncpg (listed in requirements/runtime.txt).
# Local default when using docker-compose.yml: postgres:5432, db "ordenes".
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/<database>

# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------
# Redis 7 — materialized view of external IDs (tables, menu catalog).
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Message broker
# -----------------------------------------------------------------------------
# RabbitMQ 3.x — async event broker (topic exchange).
RABBITMQ_URL=amqp://<user>:<password>@localhost:5672/

# -----------------------------------------------------------------------------
# Saga configuration
# -----------------------------------------------------------------------------
# Maximum time (in seconds) from confirmed_at before a CREATED order expires without Inventory reply (OP-01 / ADR-0001, required, no default in code); read by: no runtime service in app/ reads it yet (pending config loader and Saga Timeout Watcher in TASK-06; only scripts/setup_env.py references it).
SAGA_TIMEOUT_SECONDS=60

# Polling interval (in seconds) between Saga Timeout Watcher scans for expired orders (OP-01 / ADR-0001); read by: no service in app/ reads it yet (Saga Timeout Watcher in TASK-06 does not exist yet).
SAGA_WATCHER_INTERVAL_SECONDS=5

# -----------------------------------------------------------------------------
# KDS queue semaphore thresholds (optional until OP-11 is accepted)
# -----------------------------------------------------------------------------
# Elapsed kitchen time threshold (in seconds, from in_preparation_at) to mark a KDS card as warning/"about to be late" (OP-11 / ADR-0009, intentionally empty until OP-11 is accepted); read by: no service in app/ reads it yet (pending TASK-12 / TASK-15).
KDS_WARNING_AFTER_SECONDS=

# Elapsed kitchen time threshold (in seconds, from in_preparation_at) to mark a KDS card as critical/"late" (OP-11 / ADR-0009, intentionally empty until OP-11 is accepted); read by: no service in app/ reads it yet (pending TASK-12 / TASK-15).
KDS_LATE_AFTER_SECONDS=

# -----------------------------------------------------------------------------
# Worker tuning (optional)
# -----------------------------------------------------------------------------
# How often (in seconds) the Event Outbox Worker polls for unpublished rows.
OUTBOX_POLL_INTERVAL_SECONDS=1

# -----------------------------------------------------------------------------
# Catalog reconciliation (optional — pending approval from Menu & Catalog team)
# -----------------------------------------------------------------------------
# Endpoint exposed by the Menu & Catalog service for bootstrap/reconciliation.
# Leave empty until the contract is agreed (OP-07).
CATALOG_SYNC_URL=

# How often (in seconds) the reconciliation job runs.
# Leave empty until the value is agreed with the team.
CATALOG_RECONCILIATION_INTERVAL_SECONDS=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
