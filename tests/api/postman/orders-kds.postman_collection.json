      "name": "00 - Health & OpenAPI Inventory",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/openapi.json"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('OpenAPI 200 OK', function () { pm.response.to.have.status(200); });",
              "const doc = pm.response.json();",
              "const expected = [",
              "  ['/health', 'get'], ['/orders', 'get'], ['/orders', 'post'], ['/orders/{orderId}', 'get'],",
              "  ['/orders/{orderId}/items', 'patch'], ['/orders/{orderId}/transfer', 'patch'],",
              "  ['/orders/{orderId}/confirm', 'post'], ['/orders/{orderId}/cancel', 'patch'],",
              "  ['/orders/{orderId}/items/{itemId}/redo', 'patch'], ['/orders/{orderId}/request-bill', 'post'],",
              "  ['/orders/{orderId}/void', 'patch'], ['/orders/{orderId}/void-kitchen-error', 'patch'],",
              "  ['/kds/queue', 'get'], ['/orders/{orderId}/start-preparation', 'patch'],",
              "  ['/orders/{orderId}/items/{itemId}/ready', 'patch'], ['/orders/{orderId}/items/{itemId}/cancel', 'patch'],",
              "  ['/orders/{orderId}/items/{itemId}/kitchen-reject', 'patch'], ['/orders/{orderId}/ready', 'patch'],",
              "  ['/shifts/current', 'get'], ['/shifts/open', 'post'], ['/shifts/current/close', 'post']",
              "];",
              "expected.forEach(function (pair) {",
              "  pm.test('OpenAPI exposes ' + pair[1].toUpperCase() + ' ' + pair[0], function () {",
              "    pm.expect(doc.paths[pair[0]]).to.exist;",
              "    pm.expect(doc.paths[pair[0]][pair[1]]).to.exist;",
              "  });",
              "});"
            ]
          }
        }
      ]
