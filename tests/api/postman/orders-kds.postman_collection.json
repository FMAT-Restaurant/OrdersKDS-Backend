  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('token_waiter')) {",
          "  const rawSecret = pm.environment.get('jwtSecret') || pm.collectionVariables.get('jwtSecret') || ['local', 'dev', 'only', 'jwt', 'signing', 'key', '32b'].join('-');",
          "  const b64url = function (wordArrayOrStr) {",
          "    const raw = typeof wordArrayOrStr === 'string'",
          "      ? CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(wordArrayOrStr))",
          "      : CryptoJS.enc.Base64.stringify(wordArrayOrStr);",
          "    return raw.replace(/=+$/g, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "  };",
          "  const signJwt = function (payloadObj, secretKey, headerOverride) {",
          "    const hdr = headerOverride || { alg: 'HS256', typ: 'JWT' };",
          "    const input = b64url(JSON.stringify(hdr)) + '.' + b64url(JSON.stringify(payloadObj));",
          "    if (hdr.alg === 'none') { return input + '.'; }",
          "    const sig = b64url(CryptoJS.HmacSHA256(input, secretKey));",
          "    return input + '.' + sig;",
          "  };",
          "  const now = Math.floor(Date.now() / 1000);",
          "  const mkClaims = function (uid, role, ttlSec) {",
          "    const c = { sub: uid, user_id: uid, role: role, roles: [role], iat: now };",
          "    if (ttlSec !== null) { c.exp = now + ttlSec; }",
          "    return c;",
          "  };",
          "  pm.collectionVariables.set('token_waiter', signJwt(mkClaims('00000000-0000-0000-0000-000000000001', 'waiter', 900), rawSecret));",
          "  pm.collectionVariables.set('token_waiter_other', signJwt(mkClaims('00000000-0000-0000-0000-000000000099', 'waiter', 900), rawSecret));",
          "  pm.collectionVariables.set('token_kitchen', signJwt(mkClaims('00000000-0000-0000-0000-000000000002', 'kitchen', 900), rawSecret));",
          "  pm.collectionVariables.set('token_chef', signJwt(mkClaims('00000000-0000-0000-0000-000000000003', 'chef', 900), rawSecret));",
          "  pm.collectionVariables.set('token_admin', signJwt(mkClaims('00000000-0000-0000-0000-000000000004', 'admin', 900), rawSecret));",
          "  pm.collectionVariables.set('token_expired', signJwt(mkClaims('00000000-0000-0000-0000-000000000001', 'waiter', -120), rawSecret));",
          "  pm.collectionVariables.set('token_forged', signJwt(mkClaims('00000000-0000-0000-0000-000000000004', 'admin', 900), rawSecret + '-wrong'));",
          "  pm.collectionVariables.set('token_no_exp', signJwt(mkClaims('00000000-0000-0000-0000-000000000001', 'waiter', null), rawSecret));",
          "  pm.collectionVariables.set('token_alg_none', signJwt(mkClaims('00000000-0000-0000-0000-000000000004', 'admin', 900), rawSecret, { alg: 'none', typ: 'JWT' }));",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('CT-22 response time < 500ms', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(500);",
          "});",
          "if (pm.response.code >= 400) {",
          "  const errorSchema = {",
          "    type: 'object',",
          "    required: ['error'],",
          "    properties: {",
          "      error: {",
          "        type: 'object',",
          "        required: ['code', 'message'],",
          "        properties: {",
          "          code: {",
          "            type: 'string',",
          "            enum: [",
          "              'UNAUTHENTICATED',",
          "              'FORBIDDEN_ROLE',",
          "              'ORDER_NOT_FOUND',",
          "              'INVALID_STATE_TRANSITION',",
          "              'VERSION_CONFLICT',",
          "              'DISH_UNAVAILABLE',",
          "              'NOTE_REQUIRED',",
          "              'VALIDATION_ERROR',",
          "              'INTERNAL_ERROR'",
          "            ]",
          "          },",
          "          message: { type: 'string', minLength: 1 }",
          "        }",
          "      }",
          "    }",
          "  };",
          "  pm.test('CT-21 error envelope matches ErrorResponse schema', function () {",
          "    pm.response.to.have.jsonSchema(errorSchema);",
          "  });",
          "}"
        ]
      }
    }
  ],
