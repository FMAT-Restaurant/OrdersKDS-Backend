{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://restaurant.example.com/contracts/events/ordenes.orden.expirada.v1.json",
  "title": "OrderExpiredEvent",
  "type": "object",
  "required": [
    "eventId",
    "orderId"
  ],
  "properties": {
    "eventId": {
      "type": "string",
