    "orderId": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "elapsedSeconds": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true
}
