{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://restaurant.example.com/contracts/events/ordenes.orden.creada.v1.json",
  "title": "OrderCreatedEvent",
  "description": "Event emitted when an order enters the inventory reservation flow (RF-32, RNF-01).",
  "type": "object",
  "required": [
    "eventId",
    "orderId",
    "items"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "description": "Unique deterministic identifier of this event emission.",
      "minLength": 1
    },
    "orderId": {
      "type": "string",
      "description": "Public identifier of the affected order.",
      "minLength": 1
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Correlation identifier propagated across microservices."
    },
    "items": {
      "type": "array",
      "description": "Order dishes and quantities that Inventory must reserve.",
      "items": {
        "type": "object",
        "required": [
          "itemId",
          "name",
          "quantity"
        ],
        "properties": {
          "itemId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
