{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://restaurant.example.com/contracts/events/ordenes.cobro.solicitado.v1.json",
  "title": "ChargeRequestedEvent",
  "description": "Event emitted when payment is requested for an order (RF-20, RF-26, RF-27).",
  "type": "object",
  "required": [
    "eventId",
    "orderId"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "orderId": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "sessionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "tableId": {
      "type": [
        "string",
        "null"
      ]
    },
    "waiterId": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string"
    },
    "totalAmount": {
      "type": [
        "number",
        "string"
      ]
    },
    "items": {
      "type": "array"
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
