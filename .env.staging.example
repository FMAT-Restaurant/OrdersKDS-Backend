# Copy to .env.staging on the staging VM. Never commit the populated file.
BACKEND_IMAGE=ghcr.io/fmat-restaurant/orderskds-backend:develop
POSTGRES_DB=ordenes_staging
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=<random-secret>
POSTGRES_APP_USER=ordenes_app
POSTGRES_APP_PASSWORD=<random-secret>
POSTGRES_MIGRATION_USER=ordenes_migrator
POSTGRES_MIGRATION_PASSWORD=<random-secret>
POSTGRES_READONLY_USER=ordenes_readonly
POSTGRES_READONLY_PASSWORD=<random-secret>
REDIS_PASSWORD=<random-secret>
RABBITMQ_USER=ordenes_staging
RABBITMQ_PASSWORD=<random-secret>
RABBITMQ_VHOST=staging
RABBITMQ_EXCHANGE=ordenes.topic
SAGA_TIMEOUT_SECONDS=60
STAGING_API_PORT=8000
STAGING_RABBITMQ_PORT=5672
STAGING_RABBITMQ_MANAGEMENT_PORT=15672
